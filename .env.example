# Database Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=system_base;Username=postgres;Password=54321

# JWT Configuration
Jwt__AccessKey=SENHA_SUPER_FORTE_LONGA_PARA_MELHOR_SEGURANÇA
Jwt__RefreshKey=SENHA_SUPER_MEGA_FORTE_LONGA_PARA_MELHOR_SEGURANÇA
Jwt__ResetPasswordKey=SENHA_RESET_PASSWORD_UNICA_E_FORTE
Jwt__Issuer=AuthApi
Jwt__Audience=AuthApiUsers
Jwt__AccessExpirationMinutes=15
Jwt__ResetPasswordExpirationMinutes=15
Jwt__RefreshExpirationDays=30

# Docker
DB_NAME=system_base
DB_USER=postgres
DB_PASSWORD=54321
FORWARDED_HEADERS_KNOWN_PROXIES=172.18.0.1

# CORS Configuration
Cors__AllowedOrigins=http://localhost:3000

# caminho para o upload de arquivos
FILE_PATH=uploads

# caminho para os logs
LOG_PATH=logs

# OpenTelemetry (desativado por padrão)
# OTEL_ENABLED/OTEL_SERVICE_NAME são consumidas pelo Docker Compose.
# OpenTelemetry__* permite executar diretamente com dotnet run.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aspnet-system-base
OpenTelemetry__Enabled=false
OpenTelemetry__ServiceName=aspnet-system-base
# No Compose, use o nome do serviço do collector; com dotnet run, use localhost.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Opcional para backends autenticados, por exemplo: authorization=Bearer%20TOKEN
OTEL_EXPORTER_OTLP_HEADERS=

# aplica migrations automaticamente ao iniciar a aplicação
APPLY_MIGRATIONS_ON_STARTUP=true

# URL do frontend
FRONTEND_URL=http://localhost:4321

# Credenciais de email
MAIL_USER=
MAIL_PASS=

# Criptografia AES-256 (chave deve ter exatamente 32 bytes/256 bits)
Encryption__Key=MinhaChaveSecretaDe32BytesAES256

# KEK dos arquivos: 32 bytes aleatórios codificados em Base64.
# Linux/macOS: openssl rand -base64 32
# PowerShell 7+: [Convert]::ToBase64String(
#   [Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
FileEncryption__Kek=

# Seed user admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
